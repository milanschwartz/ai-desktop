# Docker Compose Environment Variables
# Copy this file to .env and update the values
# cp .env.example .env

# Auth Secrets (generate with: openssl rand -base64 <length>)
JWT_SECRET=your-jwt-secret-min-48-chars-generate-with-openssl-rand-base64-48
COOKIE_SECRET=your-cookie-secret-min-32-chars-generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=your-encryption-key-generate-with-openssl-rand-base64-32

# WebAuthn (Passkeys) - defaults shown below
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# CORS - defaults to http://localhost:3000
CORS_ORIGIN=http://localhost:3000
